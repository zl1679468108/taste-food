{
  "name": "taste-food-client",
  "version": "1.0.0",
  "private": true,
  "description": "小买卖点餐系统 - 微信小程序客户端",
  "main": "index.js",
  "scripts": {
    "build:weapp": "NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production taro build --type weapp",
    "build:weapp:watch": "NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development taro build --type weapp --watch",
    "start:weapp": "(lsof -ti:3011 | xargs kill -9 2>/dev/null || echo ok); NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development taro build --type weapp --watch",
    "start": "(lsof -ti:3011 | xargs kill -9 2>/dev/null || echo ok); NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development taro build --type weapp --watch",
    "test": "jest",
    "test:unit": "jest __tests__/utils.test.ts",
    "test:e2e": "jest __tests__/miniprogram.e2e.test.ts 2>&1 | tee test-output.txt",
    "test:connect": "jest __tests__/miniprogram.e2e.test.ts 2>&1 | tee test-output.txt",
    "test:coverage": "jest --coverage",
    "devtools:start": "bash ../scripts/start-devtools.sh"
  },
  "dependencies": {
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/runtime": "^7.23.0",
    "@nutui/nutui-react-taro": "3.0.20",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/react-dom": "18.3.7",
    "babel-preset-taro": "4.2.0",
    "dayjs": "^1.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io-client": "^4.7.0",
    "webpack": "5.91.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@tarojs/cli": "4.2.0",
    "@tarojs/components": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-http": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "18.3.31",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "10.6.0",
    "jest": "^30.4.2",
    "miniprogram-automator": "^0.12.1",
    "postcss": "8.5.16",
    "sass": "^1.69.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
