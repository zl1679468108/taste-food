{
  "name": "taste-food-server",
  "version": "1.0.0",
  "private": true,
  "description": "小买卖点餐系统 - NestJS 后端",
  "scripts": {
    "build": "nest build",
    "start": "(lsof -ti:3010 | xargs kill -9 2>/dev/null || echo ok); nest start --watch",
