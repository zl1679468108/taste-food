{
  "name": "taste-food-server",
  "version": "1.0.0",
  "private": true,
  "description": "小买卖点餐系统 - NestJS 后端",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bash ./scripts/start-guard.sh",
    "start:prod": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--use-env-proxy\" node dist/main",
    "start:debug": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--use-env-proxy\" nest start --debug --watch",
    "test": "NODE_ENV=test ALLOW_MEMORY_FALLBACK=true node --require ts-node/register --require reflect-metadata --require ./test/setup.ts --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/platform-socket.io": "11.1.27",
    "@nestjs/websockets": "11.1.27",
    "@supabase/supabase-js": "^2.108.2",
    "@types/multer": "^2.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "0.15.1",
    "dayjs": "^1.11.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.7.0",
    "uuid": "14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/node": "26.1.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "10.6.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "6.0.3"
  }
}
