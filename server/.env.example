# Server
SERVER_PORT=3010
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration
# 生产环境必填，长度 >= 32 字节的强随机字符串，可用 `openssl rand -hex 32` 生成
JWT_SECRET=your-jwt-secret-key-at-least-32-bytes-long
JWT_EXPIRES_IN=7d

# 是否允许内存回退模式（仅开发/测试环境设为 true，生产环境必须为 false 或不设置）
ALLOW_MEMORY_FALLBACK=true

# WeChat Mini Program
# 生产环境必填，用于 code2Session 校验登录 code
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-app-secret