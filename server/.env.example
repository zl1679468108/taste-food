# Server
SERVER_PORT=3010
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Configuration
# 生产环境必填，长度 >= 32 字节的强随机字符串，可用 `openssl rand -hex 32` 生成
JWT_SECRET=your-jwt-secret-key-at-least-32-bytes-long
JWT_EXPIRES_IN=7d

# 是否允许内存回退模式（仅开发/测试环境设为 true，生产环境必须为 false 或不设置）
ALLOW_MEMORY_FALLBACK=true

# WeChat Mini Program
# 生产环境必填，用于 code2Session 校验登录 code
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-app-secret

# ---- 支付渠道 ----
# sandbox: 开发/演示沙箱（个人主体推荐）
# wechat: 官方微信支付（需企业商户号）
# third_party: 第三方聚合预留（非免费，合规风险高，暂未实现）
PAYMENT_PROVIDER=sandbox
# 生产环境如需临时演示沙箱，显式开启（默认关闭）
ALLOW_SANDBOX_PAYMENT=true
# 官方微信支付（企业资质后配置）
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_PAY_API_KEY=
# WECHAT_MCH_API_V3_KEY=

# 腾讯位置服务 WebService Key（GCJ-02 地理编码；未配置时地址仅存文本，地图降级）
# 服务端 geocode 用「pc端」Key；小程序地图/选点用控制台「小程序」Key（AppID 绑定）
TENCENT_MAP_KEY=
