{
  "name": "taste-food",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "admin"
  ],
  "scripts": {
    "test": "npx playwright test",
    "test:admin": "npx playwright test tests/admin.spec.ts",
    "test:headed": "npx playwright test --headed",
    "test:report": "npx playwright show-report",
    "build:shared": "echo '@taste-food/shared 使用源码直接引用，无需构建'",
    "typecheck:shared": "./node_modules/.bin/tsc --noEmit --pretty false -p shared",
    "typecheck:server": "cd server && ./node_modules/.bin/tsc --noEmit --pretty false",
    "typecheck:admin": "cd admin && ./node_modules/.bin/tsc --noEmit --pretty false",
    "typecheck:client": "cd client && ./node_modules/.bin/tsc --noEmit --pretty false",
    "typecheck": "npm run typecheck:shared && npm run typecheck:server && npm run typecheck:admin && npm run typecheck:client",
    "quality:check": "node scripts/quality-check.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "playwright": "^1.61.1"
  }
}
