classDiagram
    %% ===== 数据实体 =====
    class Shop {
        +String id
        +String name
        +String address
        +String phone
        +String logo_url
        +String status
        +Int table_count
        +DateTime created_at
        +DateTime updated_at
    }

    class Category {
        +String id
        +String shop_id
        +String name
        +String icon
        +Int sort_order
        +DateTime created_at
        +DateTime updated_at
    }

    class MenuItem {
        +String id
        +String shop_id
        +String category_id
        +String name
        +String description
        +Int price
        +String image_url
        +String status
        +Int sales_count
        +Int sort_order
        +String spec_group_id
        +DateTime created_at
        +DateTime updated_at
    }

    class SpecGroup {
        +String id
        +String shop_id
        +String name
        +DateTime created_at
        +DateTime updated_at
    }

    class SpecOption {
        +String id
        +String group_id
        +String name
        +Int price_adjust
        +Int sort_order
        +DateTime created_at
        +DateTime updated_at
    }

    class Order {
        +String id
        +String shop_id
        +String user_id
        +String order_no
        +String status
        +Int total_amount
        +String delivery_type
        +String delivery_address
        +String table_no
        +String remark
        +DateTime paid_at
        +DateTime completed_at
        +DateTime created_at
        +DateTime updated_at
    }

    class OrderItem {
        +String id
        +String order_id
        +String item_id
        +String item_name
        +String spec_desc
        +Int quantity
        +Int unit_price
        +Int subtotal
        +DateTime created_at
    }

    class DeliveryInfo {
        +String id
        +String order_id
        +String type
        +String address
        +String contact_name
        +String contact_phone
        +String table_no
        +DateTime created_at
    }

    class Promotion {
        +String id
        +String shop_id
        +String type
        +Object rule
        +String status
        +DateTime created_at
        +DateTime updated_at
    }

    %% ===== 关系 =====
    Shop "1" --> "*" Category : has
    Shop "1" --> "*" MenuItem : has
    Shop "1" --> "*" SpecGroup : has
    Shop "1" --> "*" Order : receives
    Shop "1" --> "*" Promotion : offers

    Category "1" --> "*" MenuItem : contains

    SpecGroup "1" --> "*" SpecOption : has options

    MenuItem "1" --> "0..1" SpecGroup : has spec

    Order "1" --> "*" OrderItem : contains
    Order "1" --> "0..1" DeliveryInfo : has delivery

    %% ===== 前端服务层 =====
    class MenuService {
        +fetchCategories(shopId) Promise~Category[]~
        +fetchMenuItems(shopId, categoryId) Promise~MenuItem[]~
        +fetchItemDetail(itemId) Promise~MenuItemWithSpecs~
    }

    class OrderService {
        +createOrder(req) Promise~Order~
        +fetchOrderDetail(orderId) Promise~Order~
        +fetchOrderList(userId, status) Promise~Order[]~
        +payOrder(orderId) Promise~PayResponse~
    }

    class ShopService {
        +fetchShop(shopId) Promise~Shop~
    }

    class AdminService {
        +fetchOrders(shopId, status) Promise~Order[]~
        +updateOrderStatus(orderId, status) Promise~void~
        +fetchRevenue(shopId) Promise~RevenueSummary~
        +createMenuItem(req) Promise~MenuItem~
        +updateMenuItem(id, req) Promise~MenuItem~
        +toggleItemStatus(id, status) Promise~void~
        +createCategory(req) Promise~Category~
        +updateCategory(id, req) Promise~Category~
        +deleteCategory(id) Promise~void~
    }

    class WebSocketService {
        +connect(token) void
        +disconnect() void
        +joinShopRoom(shopId) void
        +joinOrderRoom(orderId) void
        +onNewOrder(callback) void
        +onOrderStatusChanged(callback) void
    }

    %% ===== Zustand Stores =====
    class CartStore {
        +CartItem[] items
        +String shopId
        +addItem(item, spec) void
        +removeItem(itemId, specId) void
        +updateQuantity(itemId, qty, specId) void
        +clearCart() void
        +getTotalAmount() Number
        +getItemCount() Number
    }

    class MenuStore {
        +Category[] categories
        +MenuItem[] items
        +String activeCategoryId
        +Boolean loading
        +fetchMenu(shopId) Promise~void~
        +setActiveCategory(categoryId) void
    }

    class OrderStore {
        +Order currentOrder
        +Order[] orderList
        +Boolean loading
        +createOrder(req) Promise~Order~
        +fetchOrderDetail(orderId) Promise~void~
        +fetchOrderList(userId) Promise~void~
    }

    class AuthStore {
        +Boolean isLoggedIn
        +String openid
        +String role
        +String shopId
        +login() Promise~void~
        +loginAsAdmin(shopId) Promise~void~
        +logout() void
    }

    %% ===== 后端 Service 层 =====
    class ShopServiceBackend {
        +getShop(id) Shop
    }

    class MenuServiceBackend {
        +getCategories(shopId) Category[]
        +getMenuItems(shopId, categoryId) MenuItem[]
        +getMenuItemDetail(id) MenuItemWithSpecs
        +createCategory(dto) Category
        +updateCategory(id, dto) Category
        +deleteCategory(id) void
        +createMenuItem(dto) MenuItem
        +updateMenuItem(id, dto) MenuItem
        +toggleItemStatus(id, status) void
    }

    class OrderServiceBackend {
        +createOrder(dto) Order
        +getOrder(id) Order
        +getOrdersByUser(userId, status, page) PaginatedData~Order~
        +getOrdersByShop(shopId, status) Order[]
        +updateOrderStatus(id, status, reason) void
    }

    class PaymentService {
        +mockPay(orderId) PayResponse
    }

    class AdminServiceBackend {
        +getShopOrders(shopId, status) Order[]
        +updateOrderStatus(id, status, reason) void
        +getRevenueSummary(shopId, date) RevenueSummary
        +createMenuItem(dto) MenuItem
        +updateMenuItem(id, dto) MenuItem
        +toggleItemStatus(id, status) void
        +createCategory(dto) Category
        +updateCategory(id, dto) Category
        +deleteCategory(id) void
        +createSpecGroup(dto) SpecGroup
        +createSpecOption(dto) SpecOption
    }

    class OrderGateway {
        +handleConnection(client) void
        +handleJoinShopRoom(client, payload) void
        +handleJoinOrderRoom(client, payload) void
        +handleLeaveRoom(client, payload) void
        +notifyNewOrder(payload) void
        +notifyOrderStatusChanged(payload) void
    }

    %% ===== 前端依赖关系 =====
    MenuService --> CartStore : provides item data
    OrderService --> OrderStore : provides order data
    AdminService --> OrderStore : provides admin data

    %% ===== 后端依赖关系 =====
    OrderServiceBackend --> OrderGateway : emits events
    AdminServiceBackend --> OrderGateway : emits events
    OrderServiceBackend --> PaymentService : calls on pay
